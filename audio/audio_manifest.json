    "しましょうか": "./audio/words/w_dff595ab26.mp3",
    "この": "./audio/words/w_fad04fc93b.mp3",
    "だけ": "./audio/words/w_520ce6127b.mp3",
    "あの": "./audio/words/w_abadd06eea.mp3",
    "だから": "./audio/words/w_7ff97b2f65.mp3",
